VITE_API_URL=http://localhost:8000

# Optional: overrides where the SSO login popup opens. Defaults to
# speechy-server's own mock endpoint. Point this at your real SSO server
# once one exists (see DEPLOYMENT.md §5). Baked in at build time, like
# VITE_API_URL — not a runtime-configurable value.
# VITE_SSO_URL=
